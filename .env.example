# Agent reads process/service environment, not this file automatically.
GBOS_API_URL=https://gbos-backend.onrender.com
# Issue a per-device credential in GBOS Settings. Do not commit real credentials.
GBOS_DEVICE_TOKEN=replace-with-this-devices-credential
# Alternatively, store just the credential in a restricted file:
# GBOS_DEVICE_TOKEN_FILE=/path/to/device-token
# Test environments ONLY. Omit for production native power execution.
GBOS_POWER_COMMAND_DRY_RUN=1
